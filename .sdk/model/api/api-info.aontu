      }
      description: "Provides daily currency exchange rates and performs conversions between a wide range of global currencies and cryptos. This API allows applications to access real-time foreign exchange data, making it ideal for e-commerce platforms, financial tools, and budgeting apps."
      security: {
        in: "query"
        name: "key"
        prefix: ""
        scheme: "ApiKeyAuth"
        type: "apiKey"
      }
      servers: [
        {
          description: "Production server"
          url: "https://hub.juheapi.com/exchangerate/v2"
        }
      ]
      summary: "Provides daily currency exchange rates and performs conversions between a wide range of global currencies and cryptos."
      termsOfService: "https://www.juheapi.com/terms-of-service"
