# Entity: rate

main: kit: entity: rate: {

  alias: field: {}

  fields: [
    {
      name: "base"
      req: true
      short: "Base currency code"
      type: "`$STRING`"
    }
    {
      name: "code"
      req: true
      short: "Response code (0 indicates success)"
      type: "`$STRING`"
    }
    {
      name: "date"
      req: false
      short: "Date of the exchange rates"
      type: "`$STRING`"
    }
    {
      name: "msg"
      req: true
      short: "Response message"
      type: "`$STRING`"
    }
    {
      name: "rates"
      req: true
      short: "Map of currency codes to exchange rates"
      type: "`$OBJECT`"
    }
    {
      name: "time_update"
      req: true
      type: "`$OBJECT`"
    }
  ]

  name: "rate"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "USD"
                kind: "query"
                name: "base"
                orig: "base"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "2025-06-26"
                kind: "query"
                name: "date"
                orig: "date"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "key"
                orig: "key"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "CNY,EUR,GBP"
                kind: "query"
                name: "symbol"
                orig: "symbol"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/rates"
          parts: [
            "rates"
          ]
          select: {
            exist: [
              "base"
              "date"
              "key"
              "symbol"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
